<div class="rnr-sheet">
  {{!-- TOP BAR --}}
  <header class="rnr-topbar">
    <h1 class="rnr-charname">
      <input name="name" type="text" value="{{actor.name}}" placeholder="Character Name" />
    </h1>
    <div class="rnr-level-badge">
      <span class="rnr-lv-label">LV</span>
      <input type="number" name="system.level" value="{{system.level}}" class="rnr-lv-input" />
    </div>
    <div class="rnr-xp-block">
      <span class="rnr-xp-label">EXP</span>
      <input type="number" name="system.exp" value="{{system.exp}}" class="rnr-xp-input" />
    </div>
  </header>

  <div class="rnr-body">
    {{!-- LEFT SIDEBAR --}}
    <aside class="rnr-sidebar">
      <div class="rnr-portrait" data-view="{{portraitView}}">
        {{#if (eq portraitView "token")}}
        <img src="{{actor.prototypeToken.texture.src}}" title="{{actor.name}}" data-action="previewImage" />
        <img class="hidden-img-editor" data-edit="prototypeToken.texture.src" src="{{actor.prototypeToken.texture.src}}" style="display:none" />
        {{else}}
        <img src="{{actor.img}}" title="{{actor.name}}" data-action="previewImage" />
        <img class="hidden-img-editor" data-edit="img" src="{{actor.img}}" style="display:none" />
        {{/if}}

        {{!-- Portrait / Token Toggle Overlay --}}
        <div class="rnr-portrait-toggle">
          <button type="button" class="rnr-toggle-btn {{#if (eq portraitView 'portrait')}}active{{/if}}" data-action="togglePortraitView" data-view="portrait" title="Portrait">
            <i class="fas fa-user"></i>
          </button>
          <button type="button" class="rnr-toggle-btn {{#if (eq portraitView 'token')}}active{{/if}}" data-action="togglePortraitView" data-view="token" title="Token">
            <i class="fas fa-circle-user"></i>
          </button>
        </div>

        {{#if editable}}
        <button type="button" class="rnr-portrait-edit" data-action="editProfileImage">
          <i class="fas fa-camera"></i>
        </button>
        {{/if}}
      </div>

      {{!-- Vitals & Defense Frame --}}
      <div class="rnr-sidebar-frame">
        {{!-- HP Bar --}}
        <div class="rnr-vital-box">
          <div class="rnr-vital-label">{{localize "ROLEANDROLL.Labels.Health"}}</div>
          <div class="rnr-bar bar-hp">
            <div class="rnr-bar-fill hp-fill" style="width: {{hpPercent}}%"></div>
            <div class="rnr-bar-content">
              <input type="number" name="system.health.value" value="{{system.health.value}}" />
              <span class="rnr-sep">/</span>
              <input type="number" name="system.health.max" value="{{system.health.max}}" readonly />
            </div>
          </div>
        </div>

        {{!-- Mental Bar --}}
        <div class="rnr-vital-box">
          <div class="rnr-vital-label">{{localize "ROLEANDROLL.Labels.Mental"}}</div>
          <div class="rnr-bar bar-mental">
            <div class="rnr-bar-fill mental-fill" style="width: {{mentalPercent}}%"></div>
            <div class="rnr-bar-content">
              <input type="number" name="system.mental.value" value="{{system.mental.value}}" />
              <span class="rnr-sep">/</span>
              <input type="number" name="system.mental.max" value="{{system.mental.max}}" />
            </div>
          </div>
        </div>

        {{!-- WP Bar --}}
        <div class="rnr-vital-box">
          <div class="rnr-vital-label">{{localize "ROLEANDROLL.Labels.WillPower"}}</div>
          <div class="rnr-bar bar-wp">
            <div class="rnr-bar-fill wp-fill" style="width: {{wpPercent}}%"></div>
            <div class="rnr-bar-content">
              <input type="number" name="system.wp.value" value="{{system.wp.value}}" min="0" />
              <span class="rnr-sep">/</span>
              <input type="number" name="system.wp.max" value="{{system.wp.max}}" readonly />
            </div>
          </div>
        </div>

        {{!-- Defense --}}
        <div class="rnr-defense">
          <input type="number" name="system.defense" value="{{system.defense}}" class="rnr-defense-value" />
          <div class="rnr-defense-label">{{localize "ROLEANDROLL.Labels.Defense"}}</div>
        </div>
      </div>
    </aside>

    {{!-- MAIN CONTENT --}}
    <main class="rnr-main">

      {{!-- ATTRIBUTES TAB --}}
      <div class="tab" data-group="primary" data-tab="attributes">
        <div class="rnr-category">
          <h3>{{localize "ROLEANDROLL.AttributeCategories.body"}}</h3>
          {{#each system.attributes as |attr key|}}
          {{#if (or (eq key "strength") (eq key "dexterity") (eq key "toughness"))}}
          <div class="rnr-row">
            <div class="rnr-row-label">
              <span class="rnr-name">{{localize (concat "ROLEANDROLL.Attributes." key)}}</span>
              {{#with (showEn (concat "ROLEANDROLL.Attributes." key)) as |en|}}
              {{#if en}}<span class="rnr-sub">{{en}}</span>{{/if}}
              {{/with}}
            </div>
            <div class="dice-pips">
              {{#each (range 1 6) as |pip|}}
              <button type="button" class="pip {{#if (lte pip attr.dice)}}filled{{/if}}" data-action="pipClick"
                data-target="attributes.{{key}}.dice" data-value="{{pip}}"></button>
              {{/each}}
            </div>
            <div class="rnr-succeed">
              <input type="checkbox" name="system.attributes.{{key}}.succeed" {{checked attr.succeed}} />
            </div>
            <button type="button" class="rnr-roll" data-action="attributeRoll" data-attribute="{{key}}">
              <i class="fas fa-dice-d20"></i>
            </button>
          </div>
          {{/if}}
          {{/each}}
        </div>

        <div class="rnr-category">
          <h3>{{localize "ROLEANDROLL.AttributeCategories.intelligenceEmotion"}}</h3>
          {{#each system.attributes as |attr key|}}
          {{#if (or (eq key "intellect") (eq key "aptitude") (eq key "sanity"))}}
          <div class="rnr-row">
            <div class="rnr-row-label">
              <span class="rnr-name">{{localize (concat "ROLEANDROLL.Attributes." key)}}</span>
              {{#with (showEn (concat "ROLEANDROLL.Attributes." key)) as |en|}}
              {{#if en}}<span class="rnr-sub">{{en}}</span>{{/if}}
              {{/with}}
            </div>
            <div class="dice-pips">
              {{#each (range 1 6) as |pip|}}
              <button type="button" class="pip {{#if (lte pip attr.dice)}}filled{{/if}}" data-action="pipClick"
                data-target="attributes.{{key}}.dice" data-value="{{pip}}"></button>
              {{/each}}
            </div>
            <div class="rnr-succeed">
              <input type="checkbox" name="system.attributes.{{key}}.succeed" {{checked attr.succeed}} />
            </div>
            <button type="button" class="rnr-roll" data-action="attributeRoll" data-attribute="{{key}}">
              <i class="fas fa-dice-d20"></i>
            </button>
          </div>
          {{/if}}
          {{/each}}
        </div>

        <div class="rnr-category">
          <h3>{{localize "ROLEANDROLL.AttributeCategories.personality"}}</h3>
          {{#each system.attributes as |attr key|}}
          {{#if (or (eq key "charm") (eq key "rhetoric") (eq key "ego"))}}
          <div class="rnr-row">
            <div class="rnr-row-label">
              <span class="rnr-name">{{localize (concat "ROLEANDROLL.Attributes." key)}}</span>
              {{#with (showEn (concat "ROLEANDROLL.Attributes." key)) as |en|}}
              {{#if en}}<span class="rnr-sub">{{en}}</span>{{/if}}
              {{/with}}
            </div>
            <div class="dice-pips">
              {{#each (range 1 6) as |pip|}}
              <button type="button" class="pip {{#if (lte pip attr.dice)}}filled{{/if}}" data-action="pipClick"
                data-target="attributes.{{key}}.dice" data-value="{{pip}}"></button>
              {{/each}}
            </div>
            <div class="rnr-succeed">
              <input type="checkbox" name="system.attributes.{{key}}.succeed" {{checked attr.succeed}} />
            </div>
            <button type="button" class="rnr-roll" data-action="attributeRoll" data-attribute="{{key}}">
              <i class="fas fa-dice-d20"></i>
            </button>
          </div>
          {{/if}}
          {{/each}}
        </div>
      </div>

      {{!-- ABILITIES TAB --}}
      <div class="tab" data-group="primary" data-tab="abilities">
        {{#each system.abilities as |category catKey|}}
        <div class="rnr-category">
          <h3>{{localize (concat "ROLEANDROLL.AbilityCategories." catKey)}}</h3>
          {{#each category as |value abilityKey|}}
          <div class="rnr-row">
            <div class="rnr-row-label">
              <span class="rnr-name">{{localize (concat "ROLEANDROLL.Abilities." abilityKey)}}{{formatAbilityAttributes value}}</span>
              {{#with (showEn (concat "ROLEANDROLL.Abilities." abilityKey)) as |en|}}
              {{#if en}}<span class="rnr-sub">{{en}}</span>{{/if}}
              {{/with}}
            </div>
            <div class="dice-pips">
              {{#each (range 1 6) as |pip|}}
              <button type="button" class="pip {{#if (lte pip value.dice)}}filled{{/if}}" data-action="pipClick"
                data-target="abilities.{{catKey}}.{{abilityKey}}.dice" data-value="{{pip}}"></button>
              {{/each}}
            </div>
            <div class="rnr-succeed">
              <input type="checkbox" name="system.abilities.{{catKey}}.{{abilityKey}}.succeed" {{checked value.succeed}} />
            </div>
            <button type="button" class="rnr-roll" data-action="abilityRoll" data-category="{{catKey}}" data-ability="{{abilityKey}}">
              <i class="fas fa-dice-d20"></i>
            </button>
          </div>
          {{/each}}
        </div>
        {{/each}}
      </div>

      {{!-- SESSION ABILITIES TAB --}}
      {{#if (isSessionAbilitiesEnabled)}}
      <div class="tab" data-group="primary" data-tab="sessionAbilities">
        <div class="rnr-category">
          <h3>{{localize "ROLEANDROLL.SessionAbilities.Title"}}</h3>
          {{#each (getSessionAbilities) as |config key|}}
          <div class="rnr-row">
            <div class="rnr-row-label">
              <span class="rnr-name">{{config.name}}</span>
            </div>
            <div class="dice-pips">
              {{#each (range 1 6) as |pip|}}
              <button type="button" class="pip {{#if (lte pip (getSessionAbilityDice ../../sessionAbilitiesData key))}}filled{{/if}}" data-action="pipClick"
                data-target="sessionAbilities.{{key}}.dice" data-value="{{pip}}"></button>
              {{/each}}
            </div>
            <div class="rnr-succeed">
              <input type="checkbox" name="system.sessionAbilities.{{key}}.succeed" {{checked (getSessionAbilitySucceed ../sessionAbilitiesData key)}} />
            </div>
            <button type="button" class="rnr-roll" data-action="sessionAbilityRoll" data-ability="{{key}}">
              <i class="fas fa-dice-d20"></i>
            </button>
          </div>
          {{/each}}
        </div>
      </div>
      {{/if}}

      {{!-- SKILLS TAB --}}
      <div class="tab" data-group="primary" data-tab="skills">
        <div class="rnr-category">
          <h3><i class="fas fa-scroll"></i> {{localize "ROLEANDROLL.Tabs.Skills"}}</h3>
          <button type="button" class="rnr-add-btn" data-action="itemCreate" data-type="skill">
            <i class="fas fa-plus"></i> {{localize "ROLEANDROLL.Labels.AddSkill"}}
          </button>
        </div>
        <ol class="rnr-skill-list">
          {{#each skills as |skill index|}}
          <li class="rnr-skill-card" data-index="{{index}}">
            <input type="text" class="rnr-skill-name" name="system.skills.{{index}}.name" value="{{skill.name}}"
              placeholder="{{localize 'ROLEANDROLL.Labels.SkillName'}}" />
            <textarea class="rnr-skill-desc" name="system.skills.{{index}}.description"
              placeholder="{{localize 'ROLEANDROLL.Labels.Description'}}" rows="2">{{skill.description}}</textarea>
            <div class="rnr-skill-actions">
              <button type="button" class="rnr-btn-small" data-action="skillShow" data-index="{{index}}">
                <i class="fas fa-comment"></i>
              </button>
              <button type="button" class="rnr-btn-small danger" data-action="itemDelete" data-index="{{index}}">
                <i class="fas fa-trash"></i>
              </button>
            </div>
          </li>
          {{/each}}
        </ol>
      </div>

      {{!-- EQUIPMENT TAB --}}
      <div class="tab" data-group="primary" data-tab="equipment">
        <div class="rnr-category">
          <h3><i class="fas fa-shield-alt"></i> {{localize "ROLEANDROLL.Tabs.Equipment"}}</h3>
          <button type="button" class="rnr-add-btn" data-action="itemCreate" data-type="equipment">
            <i class="fas fa-plus"></i> {{localize "ROLEANDROLL.Labels.AddEquipment"}}
          </button>
        </div>
        <ol class="rnr-equip-list">
          {{#each items as |item|}}
          {{#if (eq item.type "equipment")}}
          <li class="rnr-equip-card" data-item-id="{{item._id}}">
            <img class="rnr-equip-img" src="{{item.img}}" alt="{{item.name}}" />
            <div class="rnr-equip-info">
              <h4>{{item.name}}</h4>
              <div class="rnr-equip-meta">
                <span><i class="fas fa-weight-hanging"></i>
                  <input type="number" class="weight-input rnr-inline-input" data-item-id="{{item._id}}" value="{{item.system.weight}}" step="0.1" />
                </span>
                <span><i class="fas fa-layer-group"></i> {{item.system.quantity}}</span>
              </div>
            </div>
            <div class="rnr-equip-controls">
              <div class="rnr-qty-controls">
                <button type="button" class="rnr-qty-btn" data-action="quantityChange" data-item-id="{{item._id}}" data-qty-action="decrease-qty">−</button>
                <span>{{item.system.quantity}}</span>
                <button type="button" class="rnr-qty-btn" data-action="quantityChange" data-item-id="{{item._id}}" data-qty-action="increase-qty">+</button>
              </div>
              <div class="rnr-equip-btns">
                <a class="rnr-icon-btn" data-action="itemShowChat" data-item-id="{{item._id}}"><i class="fas fa-comment"></i></a>
                <a class="rnr-icon-btn" data-action="itemEdit"><i class="fas fa-edit"></i></a>
                <a class="rnr-icon-btn danger" data-action="itemDelete"><i class="fas fa-trash"></i></a>
              </div>
            </div>
          </li>
          {{/if}}
          {{/each}}
        </ol>
      </div>

      {{!-- BIO TAB --}}
      <div class="tab" data-group="primary" data-tab="bio">
        <div class="rnr-category"><h3><i class="fas fa-feather-alt"></i> {{localize "ROLEANDROLL.Bio.Biography"}}</h3></div>
        <textarea name="system.biography" rows="5" class="rnr-bio-text">{{system.biography}}</textarea>

        <div class="rnr-category"><h3>{{localize "ROLEANDROLL.Bio.SourceOfWillPower"}}</h3></div>
        <textarea name="system.sourceOfWillPower" rows="3" class="rnr-bio-text">{{system.sourceOfWillPower}}</textarea>

        <div class="rnr-bio-row">
          <div class="rnr-bio-col">
            <div class="rnr-category"><h3>{{localize "ROLEANDROLL.Bio.Buff"}}</h3></div>
            <textarea name="system.buff" rows="3" class="rnr-bio-text">{{system.buff}}</textarea>
          </div>
          <div class="rnr-bio-col">
            <div class="rnr-category"><h3>{{localize "ROLEANDROLL.Bio.Debuff"}}</h3></div>
            <textarea name="system.debuff" rows="3" class="rnr-bio-text">{{system.debuff}}</textarea>
          </div>
        </div>

        <div class="rnr-bio-row">
          <div class="rnr-bio-col">
            <div class="rnr-category"><h3>{{localize "ROLEANDROLL.Bio.Injuries"}}</h3></div>
            <textarea name="system.injuries" rows="3" class="rnr-bio-text">{{system.injuries}}</textarea>
          </div>
          <div class="rnr-bio-col">
            <div class="rnr-category"><h3>{{localize "ROLEANDROLL.Bio.Flaw"}}</h3></div>
            <textarea name="system.flaw" rows="3" class="rnr-bio-text">{{system.flaw}}</textarea>
          </div>
          <div class="rnr-bio-col">
            <div class="rnr-category"><h3>{{localize "ROLEANDROLL.Bio.PsychiatricDisorder"}}</h3></div>
            <textarea name="system.psychiatricDisorder" rows="3" class="rnr-bio-text">{{system.psychiatricDisorder}}</textarea>
          </div>
        </div>
      </div>

    </main>
  </div>

  {{!-- FLOATING TAB NAV (outside the body, positioned to overflow right edge) --}}
  <nav class="rnr-tabs" data-group="primary">
    <a class="rnr-tab" data-tab="attributes" title="{{localize 'ROLEANDROLL.Tabs.Attributes'}}"><i class="fas fa-fist-raised"></i></a>
    <a class="rnr-tab" data-tab="abilities" title="{{localize 'ROLEANDROLL.Tabs.Abilities'}}"><i class="fas fa-book-open"></i></a>
    {{#if (isSessionAbilitiesEnabled)}}
    <a class="rnr-tab" data-tab="sessionAbilities" title="{{localize 'ROLEANDROLL.Tabs.SessionAbilities'}}"><i class="fas fa-star"></i></a>
    {{/if}}
    <a class="rnr-tab" data-tab="skills" title="{{localize 'ROLEANDROLL.Tabs.Skills'}}"><i class="fas fa-scroll"></i></a>
    <a class="rnr-tab" data-tab="equipment" title="{{localize 'ROLEANDROLL.Tabs.Equipment'}}"><i class="fas fa-shield-alt"></i></a>
    <a class="rnr-tab" data-tab="bio" title="{{localize 'ROLEANDROLL.Tabs.Bio'}}"><i class="fas fa-feather-alt"></i></a>
  </nav>
</div>