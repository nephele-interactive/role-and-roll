<section class="session-abilities-config">
  <div class="dialog-header">
    <h2>{{localize "ROLEANDROLL.SessionAbilitiesConfig.Title"}}</h2>
    <p class="header-description">
      {{localize "ROLEANDROLL.SessionAbilitiesConfig.Description"}}<br>
      {{localize "ROLEANDROLL.SessionAbilitiesConfig.Instructions"}}
    </p>
  </div>
  
  <div class="ability-list">
    {{#each abilities as |ability|}}
    <div class="ability-row">
      <input type="text" class="ability-key" value="{{ability.key}}" placeholder="{{localize 'ROLEANDROLL.SessionAbilitiesConfig.KeyPlaceholder'}}" />
      <input type="text" class="ability-name" value="{{ability.name}}" placeholder="{{localize 'ROLEANDROLL.SessionAbilitiesConfig.NamePlaceholder'}}" />
      <div class="multi-select-wrapper">
        <div class="selected-items">
          {{#each ability.baseAbilities as |base|}}
          <span class="selected-tag" data-value="{{base}}">
            {{base}}
            <i class="fas fa-times remove-selected"></i>
          </span>
          {{/each}}
        </div>
        <div class="dropdown-toggle" data-action="toggleDropdown">
          <span class="placeholder">{{localize "ROLEANDROLL.SessionAbilitiesConfig.SelectPlaceholder"}}</span>
          <i class="fas fa-chevron-down"></i>
        </div>
        <div class="dropdown-options" style="display: none;">
          {{#each ../allOptions as |opt|}}
          <div class="base-ability-option {{#each ../ability.baseAbilities}}{{#if (eq this opt.value)}}selected{{/if}}{{/each}}" data-value="{{opt.value}}">
            {{opt.label}}
          </div>
          {{/each}}
        </div>
      </div>
      <select class="ability-mode">
        <option value="single" {{#if (eq ability.mode "single")}}selected{{/if}}>{{localize "ROLEANDROLL.SessionAbilitiesConfig.ModeSingle"}}</option>
        <option value="dual" {{#if (eq ability.mode "dual")}}selected{{/if}}>{{localize "ROLEANDROLL.SessionAbilitiesConfig.ModeDual"}}</option>
        <option value="select" {{#if (eq ability.mode "select")}}selected{{/if}}>{{localize "ROLEANDROLL.SessionAbilitiesConfig.ModeSelect"}}</option>
      </select>
      <button type="button" class="delete-ability" data-action="deleteAbility"><i class="fas fa-trash"></i></button>
    </div>
    {{/each}}
  </div>
  
  <button type="button" class="add-ability" data-action="addAbility"><i class="fas fa-plus"></i> {{localize "ROLEANDROLL.SessionAbilitiesConfig.AddAbility"}}</button>
  
  <div class="form-footer">
    <p class="help-text">
      {{localize "ROLEANDROLL.SessionAbilitiesConfig.HelpKey"}}<br>
      {{localize "ROLEANDROLL.SessionAbilitiesConfig.HelpName"}}<br>
      {{localize "ROLEANDROLL.SessionAbilitiesConfig.HelpMode"}}
    </p>
    <button type="submit" class="save-button"><i class="fas fa-save"></i> {{localize "ROLEANDROLL.SessionAbilitiesConfig.SaveConfiguration"}}</button>
  </div>

</section>
